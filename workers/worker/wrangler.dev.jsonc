{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rishi-worker-dev",
  "main": "src/index.ts",
  "compatibility_date": "2025-11-17",
  "compatibility_flags": ["nodejs_als", "nodejs_compat"],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "services": [
    { "binding": "SHARING_WORKER", "service": "rishi-sharing-worker-dev" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rishi-dev",
      "migrations_dir": "drizzle/migrations",
      "migrations_pattern": "drizzle/migrations/{*.sql,20260803145911_classy_sleepwalker/migration.sql,20260808181936_book_sharing/migration.sql,20260812135706_book_sharing_access/migration.sql,20260813110000_pregenerated_share_links/migration.sql,20260820112725_session_invites_from_prod_session_only/migration.sql,20260820121338_session_invites_idempotency/migration.sql}"
    }
  ],
  "r2_buckets": [
    { "binding": "APPLE", "bucket_name": "apple-dev-local" },
    { "binding": "BOOK_STORAGE", "bucket_name": "rishi-books-dev-local" },
    { "binding": "TTS_CACHE", "bucket_name": "rishi-tts-cache-dev-local" },
    { "binding": "apple_dev", "bucket_name": "apple-dev-local" }
  ],
  "kv_namespaces": [
    {
      "binding": "RISHI_DESKTOP_STATE",
      "id": "00000000000000000000000000000001",
      "preview_id": "00000000000000000000000000000002"
    },
    {
      "binding": "RATE_LIMIT_KV",
      "id": "00000000000000000000000000000003",
      "preview_id": "00000000000000000000000000000004"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "USER_USAGE_LEDGER", "class_name": "UserUsageLedger" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["UserUsageLedger"] }
  ],
  "rules": [
    { "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }
  ],
  "vars": {
    "PUBLIC_API_URL": "http://127.0.0.1:8787",
    "PUBLIC_WEB_URL": "http://127.0.0.1:8787",
    "SHARING_WORKER_WS_URL": "ws://127.0.0.1:8788",
    "SHARING_INTERNAL_SECRET": "rishi-local-development-only",
    "BETTER_AUTH_SECRET": "rishi-local-development-auth-only",
    "ACCESS_TOKEN_SECRET": "rishi-local-development-access-only",
    "REFRESH_TOKEN_SECRET": "rishi-local-development-refresh-only",
    "BOOK_MAX_FILE_BYTES": "838860800",
    "BOOK_MAX_PER_USER": "500",
    "BOOK_MAX_USER_BYTES": "10737418240"
  }
}
