{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "rishi-worker",
	"main": "src/index.ts",
	"compatibility_date": "2025-11-17",
	"compatibility_flags": [
		"nodejs_als",
		"nodejs_compat"
	],
	"version_metadata": {
		"binding": "CF_VERSION_METADATA"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "rishi",
			"database_id": "970159b7-ca91-49c1-bae8-feb43b24a7e6",
			"migrations_dir": "drizzle/migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "APPLE",
			"bucket_name": "apple",
			"remote": true

		},
		{
			"binding": "BOOK_STORAGE",
			"bucket_name": "rishi-books"
		},
		{
			"binding": "TTS_CACHE",
			"bucket_name": "rishi-tts-cache"
		},
		{
			"bucket_name": "apple-dev",
			"binding": "apple_dev"
		}
	],
	"kv_namespaces": [
		{
			"binding": "RISHI_DESKTOP_STATE",
			"id": "12eb084c99f44bebafcf1143bc457f58",
			"preview_id": "49a43a76aac747ad8472856f33e1eeda"
		},
		{
			// Dedicated to workers/worker/src/ops/rate-limit.ts. NOT the same
			// namespace as RISHI_DESKTOP_STATE — repo research confirmed that
			// namespace has zero production call sites today, but repurposing it
			// would still couple unrelated desktop-sync-state and rate-limit
			// semantics for no benefit. This binding may be wiped/recreated
			// independently (e.g. to change key layout) without touching
			// desktop state.
			// id/preview_id are PLACEHOLDERS — replace with the real values from
			// `npx wrangler kv namespace create RATE_LIMIT_KV` (and `--preview`)
			// before this binding will work in `wrangler dev`/deploy. Could not
			// be created here (no Cloudflare credentials/network access in this
			// environment).
			"binding": "RATE_LIMIT_KV",
			"id": "REPLACE_WITH_REAL_ID_FROM_WRANGLER_KV_NAMESPACE_CREATE",
			"preview_id": "REPLACE_WITH_REAL_PREVIEW_ID_FROM_WRANGLER_KV_NAMESPACE_CREATE"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "USER_USAGE_LEDGER",
				"class_name": "UserUsageLedger"
			}
		]
	},
	// SQLite-backed DO storage — required so ctx.storage is the synchronous,
	// atomic SQLite backend (not the legacy KV backend). Never rename this
	// tag or reuse it for a different class; add a new tag for future
	// Durable Object classes instead.
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["UserUsageLedger"]
		}
	],
	// Lets the bundler embed the drizzle-kit-generated DO migration SQL
	// (imported as text by drizzle/ledger-do-migrations/migrations.js) into
	// the deployed Worker, since Durable Objects have no filesystem access
	// at runtime.
	"rules": [
		{
			"type": "Text",
			"globs": ["**/*.sql"],
			"fallthrough": true
		}
	],
	"vars": {
		"PUBLIC_API_URL": "https://api.fidexa.org",
		"PUBLIC_WEB_URL": "https://rishi.fidexa.org",
		// ─── /api/sync/upload-url storage caps ───────────────────────────────
		// wrangler passes numeric vars as strings; defaults in upload.ts kick in
		// if these are unset. Override per-environment as needed.
		"BOOK_MAX_FILE_BYTES": "838860800", // 800 MB per uploaded file
		"BOOK_MAX_PER_USER": "500", // count of non-deleted books / user
		"BOOK_MAX_USER_BYTES": "10737418240" // 10 GB total per user (sum of fileSize)
		// ENABLE_TEST_AUTH + TEST_AUTH_SECRET are intentionally NOT defined here.
		// Set them ONLY in dev/staging via `wrangler secret put` to keep prod
		// hard-gated by absence.
		// ENABLE_OPS_ADMIN + OPS_ADMIN_SECRET (src/routes/ops-flags.ts) follow the
		// exact same rule: set ONLY in dev/staging via `wrangler secret put`.
	},
	"routes": [
		{
			"pattern": "api.fidexa.org",
			"custom_domain": true
		}
	]
}