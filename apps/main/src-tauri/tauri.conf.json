{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rishi",
  "version": "1.3.15",
  "identifier": "org.fidexa.rishi",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "rishi",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "focus": false,
        "width": 1024,
        "height": 770
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' https://img.clerk.com  https://rishi-tauri.s3.us-east-1.amazonaws.com asset: http://asset.localhost data: blob:; font-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline' asset: http://asset.localhost blob:; script-src 'self' 'unsafe-inline'; media-src 'self' http://asset.localhost asset:; connect-src ipc://localhost 'self' asset: http://asset.localhost wss://api.openai.com https://api.openai.com ws://127.0.0.1:* ws://localhost:*",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$APPLOCALDATA/**"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJDNzNEMkU1OTZDODc4RDEKUldUUmVNaVc1ZEp6dkNqRitLT3pKUGRTTlZLZ21VSWhtVTgrMFlDd3QrQW9JTVdFUk80QnlNYnQK",
      "endpoints": [
        "https://github.com/matovu-farid/rishi-monorepo/releases/latest/download/latest.json"
      ]
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "rishi"
        ]
      },
      "mobile": [
        {
          "scheme": [
            "rishi"
          ],
          "appLink": false
        }
      ]
    },
    "sql": {
      "preload": [
        "sqlite:rishi.db"
      ]
    }
  },
  "bundle": {
    "publisher": "Fidexa",
    "createUpdaterArtifacts": true,
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
      "developmentTeam": "rishi"
    },
    "macOS": {
      "entitlements": "./Entitlements.plist"
    },
    "windows": {
      "signCommand": "trusted-signing-cli -e https://eus.codesigning.azure.net -a RishiSigning -c RishiPublicTrust -d Rishi %1"
    }
  }
}
