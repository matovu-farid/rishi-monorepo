{
  "name": "rishi-electron",
  "version": "1.3.28",
  "description": "Rishi - AI-Powered Book Reader (Electron)",
  "main": "./out/main/index.js",
  "author": {
    "name": "Fidexa",
    "email": "support@fidexa.org"
  },
  "homepage": "https://rishi.fidexa.org",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "postinstall": "electron-rebuild -f && node scripts/ensure-sharp-vendor.cjs",
    "clean:dist": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true,maxRetries:5,retryDelay:300})\"",
    "build:unpack": "pnpm run clean:dist && pnpm run build && electron-builder --dir",
    "build:win": "pnpm run clean:dist && pnpm run build && electron-builder --win",
    "build:mac": "pnpm run clean:dist && pnpm run build && electron-builder --mac --x64 --arm64",
    "build:mac:debug": "pnpm run clean:dist && electron-vite build --sourcemap && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --dir -c.mac.notarize=false -c.mac.identity=- -c.mac.hardenedRuntime=false -c.mac.gatekeeperAssess=false",
    "build:linux": "pnpm run clean:dist && pnpm run build && electron-builder --linux",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@openai/agents": "^0.3.9",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@rishi/shared": "workspace:*",
    "@sentry/electron": "^7.12.0",
    "@tanstack/react-query": "^5.90.5",
    "@tanstack/react-router": "^1.133.15",
    "@tanstack/react-virtual": "^3.13.12",
    "@use-gesture/react": "^10.3.1",
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^12.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.2.6",
    "drizzle-orm": "^0.45.2",
    "effect": "^3.21.2",
    "electron-updater": "^6.6.2",
    "embla-carousel-react": "^8.6.0",
    "epubjs": "^0.3.93",
    "eventemitter3": "^5.0.1",
    "fast-deep-equal": "^3.1.3",
    "framer-motion": "^12.23.24",
    "hnswlib-node": "^3.0.0",
    "jszip": "^3.10.1",
    "kysely": "^0.28.8",
    "lodash.clonedeep": "^4.5.0",
    "lodash.isequal": "^4.5.0",
    "lucide-react": "^0.552.0",
    "magic-bytes.js": "^1.12.1",
    "marks-pane": "^1.0.9",
    "md5": "^2.3.0",
    "nuqs": "^2.8.6",
    "path-browserify": "^1.0.1",
    "pdf-parse": "^1.1.1",
    "radix-ui": "^1.4.3",
    "react-dropzone": "^14.3.8",
    "react-pdf": "^10.2.0",
    "react-reader": "^2.0.15",
    "react-spinners": "^0.17.0",
    "react-swipeable": "^7.0.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "throttle-debounce": "^5.0.2",
    "ts-retry-promise": "^0.8.1",
    "tw-animate-css": "^1.4.0",
    "uuid": "^13.0.0",
    "xstate": "^5.30.0",
    "zod": "^3.23.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.1.16",
    "@tanstack/react-router-devtools": "^1.133.15",
    "@tanstack/router-plugin": "^1.133.27",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/dompurify": "^3.2.0",
    "@types/lodash.clonedeep": "^4.5.9",
    "@types/lodash.isequal": "^4.5.8",
    "@types/md5": "^2.3.6",
    "@types/node": "^22.19.1",
    "@types/pdf-parse": "^1.1.4",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/throttle-debounce": "^5.0.2",
    "@vitejs/plugin-react": "^5.1.1",
    "drizzle-kit": "^0.31.10",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "happy-dom": "^20.0.10",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vite-plugin-static-copy": "^3.1.4",
    "vitest": "^4.0.14"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild",
      "hnswlib-node",
      "sharp"
    ]
  }
}
