default_platform(:ios)

platform :ios do
  desc "Upload dSYMs from the most recent archive to Sentry. Called by ci_post_xcodebuild.sh."
  lane :upload_dsyms do |options|
    archive_path   = options[:archive_path]   || ENV["CI_ARCHIVE_PATH"]
    sentry_org     = options[:sentry_org]     || ENV["SENTRY_ORG_SLUG"]
    sentry_project = options[:sentry_project] || ENV["SENTRY_PROJECT_SLUG"]

    UI.user_error!("archive_path missing") unless archive_path

    dsym_path = File.join(archive_path, "dSYMs")
    sh("sentry-cli debug-files upload --auth-token \"$SENTRY_AUTH_TOKEN\" " \
       "--org #{sentry_org} --project #{sentry_project} \"#{dsym_path}\"")
  end

  desc "Skeleton TestFlight build — proves the signing + upload pipeline end-to-end. " \
       "Builds the unmodified rishi scheme and pushes a TestFlight build with no testers."
  lane :testflight_skeleton do
    build_app(
      project: "rishi/rishi.xcodeproj",
      scheme: "rishi",
      configuration: "Release",
      clean: true,
      export_method: "app-store"
    )
    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      changelog: "Skeleton build from Phase 0 BOOT-09 — proves pipeline only. Not for distribution."
    )
  end

  desc "Validate fastlane metadata files (per-field char limits, URL schemes, presence). " \
       "Exits non-zero if any en-US or review_information field is missing, empty, oversized, or malformed."
  lane :metadata_validate do
    script = File.expand_path('../scripts/validate_metadata.rb', __dir__)
    root   = File.expand_path('..', __dir__)
    sh("ruby #{script.shellescape} #{root.shellescape}")
  end

  desc "Build the iOS app for App Store, upload metadata + screenshots, DO NOT submit. " \
       "Run the manual submit step in plan 12-06 when the build is ready for review. " \
       "Pass SKIP_SCREENSHOTS=1 for dry-runs before captures land."
  lane :release_app_store do
    metadata_validate
    build_app(
      project: "rishi/rishi.xcodeproj",
      scheme: "rishi",
      configuration: "Release",
      clean: true,
      export_method: "app-store"
    )
    upload_to_app_store(
      submit_for_review: false,
      automatic_release: false,
      force: true,
      skip_screenshots: ENV["SKIP_SCREENSHOTS"] == "1",
      precheck_include_in_app_purchases: false,
      submission_information: { add_id_info_uses_idfa: false }
    )
  end

  desc "Build the Mac Catalyst app, upload metadata + screenshots to the Mac App Store, DO NOT submit. " \
       "Same SKIP_SCREENSHOTS=1 escape hatch as release_app_store."
  lane :release_mac_app_store do
    metadata_validate
    build_app(
      project: "rishi/rishi.xcodeproj",
      scheme: "rishi",
      configuration: "Release",
      clean: true,
      destination: "generic/platform=macOS,variant=Mac Catalyst",
      export_method: "app-store"
    )
    upload_to_app_store(
      platform: "osx",
      submit_for_review: false,
      automatic_release: false,
      force: true,
      skip_screenshots: ENV["SKIP_SCREENSHOTS"] == "1"
    )
  end

  desc "Capture placeholder + real screenshots for every supported device frame. " \
       "Invokes fastlane/scripts/capture_screenshots.sh which seeds 1x1 PNG placeholders " \
       "for any frame that does not already have a capture committed."
  lane :capture_screenshots do
    sh("bash #{File.expand_path('../scripts/capture_screenshots.sh', __dir__)}")
  end

  desc "Build Release iOS + upload to TestFlight (internal testers only). " \
       "Reads changelog from fastlane/changelog.txt if present, else from `git log -1 --pretty=%B`. " \
       "Validates metadata first so a malformed name/keywords block never reaches Apple."
  lane :release_testflight do
    metadata_validate

    changelog_path = File.expand_path('../changelog.txt', __dir__)
    changelog = if File.file?(changelog_path)
      File.read(changelog_path)
    else
      `git log -1 --pretty=%B`.strip
    end

    build_app(
      project: "rishi/rishi.xcodeproj",
      scheme: "rishi",
      configuration: "Release",
      clean: true,
      export_method: "app-store"
    )

    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      changelog: changelog,
      notify_external_testers: false
    )
  end

  desc "Build Mac Catalyst Release + upload to TestFlight (internal testers). " \
       "Same changelog source as release_testflight."
  lane :release_mac_testflight do
    metadata_validate

    changelog_path = File.expand_path('../changelog.txt', __dir__)
    changelog = if File.file?(changelog_path)
      File.read(changelog_path)
    else
      `git log -1 --pretty=%B`.strip
    end

    build_app(
      project: "rishi/rishi.xcodeproj",
      scheme: "rishi",
      configuration: "Release",
      clean: true,
      destination: "generic/platform=macOS,variant=Mac Catalyst",
      export_method: "app-store"
    )

    upload_to_testflight(
      platform: "osx",
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      changelog: changelog,
      notify_external_testers: false
    )
  end
end
