{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rishi-sharing-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-30",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "durable_objects": {
    "bindings": [
      { "name": "SESSION_ROOM", "class_name": "SessionRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SessionRoom"] }
  ],
  "vars": {
    "AUTH_BASE_URL": "https://rishi.fidexa.org"
  },
  "routes": [
    { "pattern": "sharing.fidexa.org", "custom_domain": true }
  ],
  "env": {
    "production": {
      "name": "rishi-sharing-worker",
      // NOTE: secrets are NOT declared in `vars` — they're set out-of-band
      // via `wrangler secret put ... --env production` so they never land
      // in the repo. Production-required secrets:
      //   WORKER_HMAC_SECRET - signs joinToken + reconnectToken
      // Production also DELIBERATELY omits the `TEST_AUTH_ALLOWED` var so
      // the `userId--DisplayName` E2E bearer shortcut and the
      // `data.channel.relay` test path are both rejected by the DO.
      "vars": {
        "AUTH_BASE_URL": "https://rishi.fidexa.org"
      },
      "routes": [
        { "pattern": "sharing.fidexa.org", "custom_domain": true }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "SESSION_ROOM", "class_name": "SessionRoom" }
        ]
      },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["SessionRoom"] }
      ]
    }
  }
  // Secrets set via `wrangler secret put`:
  //   WORKER_HMAC_SECRET  - signs joinToken + reconnectToken
  //   TURN_KEY_ID         - Cloudflare Realtime TURN key identifier
  //   TURN_API_TOKEN      - Cloudflare Realtime TURN API token
}
