<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.education</string>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>org.fidexa.rishi.sync.refresh</string>
		<string>org.fidexa.rishi.sync.processing</string>
	</array>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>EPUB</string>
			<key>CFBundleTypeRole</key>
			<string>None</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>org.idpf.epub-container</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>PDF</string>
			<key>CFBundleTypeRole</key>
			<string>None</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.adobe.pdf</string>
			</array>
		</dict>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>org.fidexa.rishi</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>rishi</string>
			</array>
		</dict>
	</array>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>LSEnvironment</key>
	<dict>
		<!-- Workaround for a PDFKit bug: PDFPageAnalyzerV2 form-field
		     detection runs on its background formFillingQueue and mutates a
		     PDFAnnotation via -[PDFAnnotation updateAnnotationEffect], which
		     asserts main-actor isolation. Under the Swift 6 runtime that
		     assertion (swift_task_isCurrentExecutor -> checkIsolated ->
		     dispatch_assert_queue) aborts the process. Legacy mode makes
		     isCurrentExecutor return false instead of aborting. macOS/Catalyst
		     LaunchServices launches only; ignored on iOS. -->
		<key>SWIFT_IS_CURRENT_EXECUTOR_LEGACY_MODE_OVERRIDE</key>
		<string>legacy</string>
	</dict>
</dict>
</plist>
