{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "lib": [
      "ESNext"
    ],
    "types": [
      "@cloudflare/workers-types"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "paths": {
      "@rishi/shared": ["../../packages/shared/src/index.ts"],
      "@rishi/shared/*": ["../../packages/shared/src/*"],
      "drizzle-orm": ["./node_modules/drizzle-orm"],
      "drizzle-orm/*": ["./node_modules/drizzle-orm/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "scripts/**/*.ts", "drizzle.config.ts", "../../packages/shared/src/**/*.ts"],
  "exclude": [
    "node_modules",
    "../../packages/shared/src/tts/**",
    "../../packages/shared/src/voice-chat/**",
    "../../packages/shared/src/formats/**",
    "../../packages/shared/src/machines/**",
    "../../packages/shared/src/book-import/**",
    "../../packages/shared/src/indexing/**",
    "../../packages/shared/src/connectivity/**"
  ]
}
