# Public-hoist NativeWind's runtime so Metro can resolve it.
# babel-preset-expo's `jsxImportSource: "nativewind"` makes the JSX compiler
# emit `import ... from 'nativewind/jsx-runtime'`, which internally imports
# `react-native-css-interop/jsx-runtime`. Metro's resolver does not walk
# pnpm's `.pnpm/` isolated layout, so the package must be top-level in
# `apps/mobile/node_modules/`.
public-hoist-pattern[]=*react-native-css-interop*
public-hoist-pattern[]=*nativewind*
